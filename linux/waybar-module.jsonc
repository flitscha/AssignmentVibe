// Snippet for ~/.config/waybar/config.jsonc.
//
// 1. Add this module to "modules-right" (or -left/-center), e.g.:
//    "modules-right": ["custom/assignmentvibe", "clock", ...]
// 2. Put the block below at the JSON object level of config.jsonc
//    (the same level as other "custom/..." modules).
//
// Mouse buttons:
//   left    the hub: pick a task, pick the chapters, copy the prompt
//   right   straight to the follow-ups ("Expand on that last step" ...), which
//           you need mid-chat rather than on the way into the hub
//   middle  forget the context
//
// On Omarchy the shell bar (linux/omarchy-shell-widget.md) replaces Waybar;
// this file is for a plain Waybar setup. Styling goes in your own
// ~/.config/waybar/style.css under .custom-assignmentvibe.
{
  "custom/assignmentvibe": {
    "exec": "assignmentvibe waybar-status",
    "return-type": "json",
    "interval": 15,
    "on-click": "assignmentvibe pick",
    "on-click-right": "assignmentvibe followup",
    "on-click-middle": "assignmentvibe context clear",
    "tooltip": true
  }
}
