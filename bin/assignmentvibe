#!/usr/bin/env bash
# Startet assignmentvibe auch ohne 'pip install' - direkt aus dem geklonten
# Repo heraus (nach Omarchy-Konvention: bin/-Skripte sind ohne Installation
# lauffaehig, einfach auf PATH legen oder symlinken). Ist das Paket bereits
# via pip installiert, wird stattdessen der 'echte' Befehl auf PATH benutzt.
set -euo pipefail

# readlink -f, weil dieses Skript ueblicherweise als Symlink auf dem PATH liegt
# (~/.local/bin/assignmentvibe). Ohne Aufloesen waere REPO_ROOT ~/.local, und
# das Paket wuerde nur gefunden, wenn man zufaellig im Repo-Ordner steht.
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
REPO_ROOT="$(dirname "$(dirname "$SELF")")"

ON_PATH="$(command -v assignmentvibe 2>/dev/null || true)"
if [[ -n "$ON_PATH" && "$(readlink -f "$ON_PATH")" != "$SELF" ]]; then
  exec "$ON_PATH" "$@"
fi

# The repository is also an Omarchy plugin, and the shell reloads a plugin on
# any file written into its folder - __pycache__ included. So the bytecode
# cache lives in ~/.cache instead.
export PYTHONPYCACHEPREFIX="${PYTHONPYCACHEPREFIX:-${XDG_CACHE_HOME:-$HOME/.cache}/assignmentvibe/pycache}"
exec env PYTHONPATH="$REPO_ROOT:${PYTHONPATH:-}" python3 -m assignmentvibe.cli "$@"
